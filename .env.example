# Kopieer dit bestand naar .env.local en vul de waarden in.
# .env.local staat in .gitignore en komt nooit in Git.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Alleen server-side: voor /api/sync (stap 3). Nooit NEXT_PUBLIC_ ervoor zetten.
SUPABASE_SERVICE_ROLE_KEY=

# Geheime sleutel waarmee de GitHub Action /api/sync mag aanroepen (stap 3)
SYNC_SECRET=
